NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://momentia:local@localhost:5432/momentia
DATABASE_SSL=false
DATABASE_POOL_MAX=10
CORS_ORIGINS=

# Configure all three only after selecting an OIDC provider.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# Optional S3-compatible private object storage (for example Cloudflare R2).
# Keep the bucket private. Configure all four values together; never commit real secrets.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
