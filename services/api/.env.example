NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://momentia:local@localhost:5432/momentia
DATABASE_SSL=false
DATABASE_POOL_MAX=10
CORS_ORIGINS=

# Configure all three only after selecting an OIDC provider.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# Internal workers: use independently generated random secrets (32+ characters).
MEDIA_WORKER_TOKEN=
NOTIFICATION_WORKER_TOKEN=
PUSH_TOKEN_ENCRYPTION_KEY=
MOMENTIA_MODERATOR_USER_IDS=

# Optional multi-instance Social Audio broadcast adapter.
AUDIO_REDIS_URL=

# Media storage: local (shared volume) or s3 (S3-compatible object storage).
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_DIR=/var/lib/momentia/media
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false
