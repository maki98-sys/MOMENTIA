MEDIA_API_URL=http://api:3000
MEDIA_WORKER_TOKEN=
NOTIFICATION_WORKER_TOKEN=
MEDIA_WORKER_ID=momentia-media-worker-1
MEDIA_WORKER_POLL_MS=1500
MEDIA_WORKER_BATCH_SIZE=5

# Must match the API storage provider and configuration.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_DIR=/var/lib/momentia/media
MEDIA_WORKER_TEMP_DIR=/tmp/momentia-media-worker
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false

# Optional malware scanner.
CLAMD_HOST=
CLAMD_PORT=3310
FFMPEG_PATH=ffmpeg
# Worker-enforced FFmpeg wall-clock timeout (1000..300000 ms).
MEDIA_FFMPEG_TIMEOUT_MS=120000
# Maximum decoded image pixels per source (1M..100M).
MEDIA_MAX_IMAGE_PIXELS=40000000
